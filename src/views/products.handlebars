<h2>Каталог товаров</h2>

<div class="products">
    {{#if products.length}}
        {{#each products}}
            <article class="product">
                <h3>{{name}}</h3>
                <p>Цена: {{price}} руб.</p>
                <p>Категория: {{category}}</p>
                <p>{{description}}</p>
                <a href="/products/{{id}}">
                    Подробнее
                </a>
            </article>
        {{/each}}
    {{else}}
        <p>Товары пока отсутствуют</p>
    {{/if}}
</div>
